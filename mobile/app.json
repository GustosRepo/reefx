{
  "expo": {
    "name": "AquaXone",
    "slug": "aquaxone",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/iconax.png",
    "scheme": "aquaxone",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0891b2"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aquaxone.app",
      "buildNumber": "33",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "AquaXone needs camera access to take photos of your aquarium for the gallery.",
        "NSPhotoLibraryUsageDescription": "AquaXone needs photo library access to save and select aquarium photos.",
        "NSPhotoLibraryAddUsageDescription": "AquaXone needs permission to save photos to your library.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": []
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0891b2"
      },
      "package": "com.aquaxone.app",
      "versionCode": 22,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#0891b2"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow AquaXone to access your camera to take photos of your aquarium."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AquaXone to access your photos for the aquarium gallery."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "4b77890a-0c32-41d4-a99f-e1009bbce051"
      }
    },
    "owner": "codewerx"
  }
}
